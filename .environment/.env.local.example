APP_NAME="Bomb Busters"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://bombbusters.localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

TZ=Europe/Budapest
MEMORY_LIMIT=512M
REQUEST_TIMEOUT=300
OPCACHE_ENABLE=0
OPCACHE_CLI_ENABLE=0

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=bombbusters-local-database
DB_USERNAME=bombbusters-local-user
DB_PASSWORD=bombbusters-local-password

SESSION_DRIVER=redis
SESSION_LIFETIME=10080
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb

REDIS_CLIENT=phpredis
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_PASSWORD=null

# Reverb: the server listens on 0.0.0.0:8080 in the "reverb" container.
# PHP publishes events straight to it over the Docker network;
# browsers reach it through Traefik on the same host/port they loaded the page from (see resources/js/echo.js).
REVERB_APP_ID=309853
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_APP_NAME="Bomb Busters"
VITE_REVERB_APP_KEY=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:push@example.com
